# ================================================================
# VARIÁVEIS DE AMBIENTE — CAIXA JS GRÁFICA
# ================================================================
# Copie este arquivo para .env.local e preencha os valores
# No Vercel: adicione em Project Settings > Environment Variables
# ================================================================

# Supabase (fonte de verdade)
NEXT_PUBLIC_SUPABASE_URL=https://arqkdnexpederquztegn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# service_role — só usada server-side (lib/supabase-admin.ts), NUNCA prefixar
# com NEXT_PUBLIC_. Pegue em Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui


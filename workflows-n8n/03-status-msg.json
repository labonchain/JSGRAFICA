    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\n\nconst messageId = raw.messageId ?? raw.message_id ?? raw.ids?.[0] ?? raw.zaapId ?? null;\n\nif (!messageId) {\n  return [];\n}\n\nfunction toSP(ms) {\n  if (!ms) return null;\n  return new Date(\n    new Date(ms).toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' })\n  ).toISOString().replace('Z', '-03:00');\n}\n\nconst eventAt = raw.momment ? toSP(raw.momment) : toSP(Date.now());\n\nlet status = null;\nlet delivered_at = null;\nlet read_at = null;\n\nif (raw.type === 'DeliveryCallback') {\n  status = 'DELIVERED';\n  delivered_at = eventAt;\n}\n\nif (raw.type === 'ReadCallback') {\n  status = 'READ';\n  read_at = eventAt;\n}\n\nif (raw.type === 'MessageStatusCallback') {\n  if (raw.status === 'READ' || raw.status === 'READ_BY_ME') {\n    status = 'READ';\n    read_at = eventAt;\n  } else if (raw.status === 'SENT' || raw.status === 'RECEIVED') {\n    status = raw.status;\n  }\n}\n\nreturn [{\n  json: {\n    message_id: messageId,\n    status: status,\n    delivered_at: delivered_at,\n    read_at: read_at,\n    last_update_at: eventAt\n  }\n}];"
      },

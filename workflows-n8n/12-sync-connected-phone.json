      "id": "get-device-013",
      "name": "GET Device Z-API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -352,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const config = $('GET Config').first().json;\nconst device = $json || {};\n\n// normaliza telefone (so digitos)\nfunction normaliza(v) { return String(v || '').replace(/\\D/g, ''); }\n\nconst phoneAtualBanco = normaliza(config.connected_phone);\nconst phoneAgoraZapi = normaliza(device.phone);\n\n// se a chamada ao Z-API falhou ou nao trouxe phone, nao faz nada\nif (!phoneAgoraZapi) {\n  return [{ json: { _deve_atualizar: false, _motivo: 'sem_resposta_valida_zapi' } }];\n}\n\nconst mudou = phoneAgoraZapi !== phoneAtualBanco;\n\nreturn [{\n  json: {\n    _deve_atualizar: mudou,\n    _config_id: config.id,\n    _phone_anterior: config.connected_phone || null,\n    _phone_novo: device.phone,\n    _motivo: mudou ? 'telefone_mudou' : 'sem_mudanca'\n  }\n}];"
      },
      "id": "comparar-013",
      "name": "Comparar e Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json._deve_atualizar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "if-mudou-013",
      "name": "If Mudou",
      "type": "n8n-nodes-base.if",

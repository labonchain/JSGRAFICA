    {
      "id": "n355-montar",
      "name": "Montar Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const config = $('GET Config').first().json;\nconst baseUrl = config.zapi_url.replace(/\\/send-text$/, '');\nconst clientToken = config.client_token;\nconst canalId = config.canal_whatsapp_id;\n\nconst items = $input.all();\nconst resultado = [];\n\nitems.forEach((item, idx) => {\n  const post = item.json;\n  let endpoint = null;\n  let body = null;\n\n  if (post.tipo === 'text') {\n    endpoint = 'send-text';\n    body = { phone: canalId, message: post.texto || '' };\n  } else if (post.tipo === 'image') {\n    endpoint = 'send-image';\n    body = { phone: canalId, image: post.image_url || '', caption: post.caption_image || undefined };\n  } else if (post.tipo === 'video') {\n    endpoint = 'send-video';\n    body = { phone: canalId, video: post.video_url || '', caption: post.caption_video || undefined };\n  } else {\n    return;\n  }\n\n  resultado.push({\n    json: {\n      post_id: post.id,\n      url: baseUrl + '/' + endpoint,\n      body: body,\n      _client_token: clientToken\n    },\n    pairedItem: { item: idx }\n  });\n});\n\nreturn resultado;"
      }
    },
    {
      "id": "n355-http",

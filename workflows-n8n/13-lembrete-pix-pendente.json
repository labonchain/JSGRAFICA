    {
      "parameters": {
        "jsCode": "// Filtra quem ja recebeu lembrete e monta a mensagem\n// Define pairedItem explicitamente (indice original) pra nao quebrar\n// referencias de nos mais a frente (Marcar Lembrete Enviado usa $('Montar Lembrete').item)\nconst config = $('GET Config').first().json;\nconst pedidosItems = $input.all();\n\nconst resultado = [];\npedidosItems.forEach((item, idx) => {\n  const pedido = item.json;\n  if (pedido.lembrete_pix_enviado_at) return;\n\n  const chavePix = pedido.chave_pix || config.chave_pix;\n  const titularPix = config.titular_pix;\n  const valor = Number(pedido.valor_final || 0).toFixed(2);\n  const message = `Oi! Passando pra lembrar que seu pedido (${pedido.servico_nome || 'seu pedido'}) `\n    + `continua aguardando o pagamento pra gente iniciar a producao 😊\n\n`\n    + `Chave Pix:\n📱 *${chavePix}*\n`\n    + `Titular: ${titularPix}\n`\n    + `💰 Valor: *R$ ${valor}*\n\n`\n    + `Quando fizer o pix, me manda o comprovante aqui.`;\n\n  resultado.push({\n    json: {\n      pedido_id: pedido.id,\n      telefone: pedido.telefone,\n      message,\n      _zapi_url: config.zapi_url,\n      _zapi_token: config.client_token\n    },\n    pairedItem: { item: idx }\n  });\n});\n\nreturn resultado;"
      },
      "id": "montar-lembrete-047",
      "name": "Montar Lembrete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json._zapi_url }}",
